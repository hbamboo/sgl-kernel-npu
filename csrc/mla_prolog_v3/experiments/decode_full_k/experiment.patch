+// Decode experiment: D=192, M<=64. L1A<=24 KiB, L1B=96 KiB,
+// L0A/L0B<=24 KiB, L0C<=16 KiB per ping/pong. Keep the BF16 QC boundary.
+template <typename T, typename O, typename S>
+__aicore__ inline void MatmulQnFullK(const GlobalTensor<O>& dst,
+    const GlobalTensor<T>& a, const GlobalTensor<T>& b, const MMParams& para, MMBufParams& buf)
+{
+    using Acc = float;
+    const uint32_t m = Align(para.m, BLOCK_CUBE_SIZE);
+    mmLocalTensors<T, Acc> local;
+    local.Init(buf);
+    LoadL1A(a, para.m, para.k, para.orgKa, buf);
+    WaitFlag<HardEvent::MTE2_MTE1>(A_EVENT0 + (buf.aL1BufIter & 1u));
+    LocalTensor<T> aL1 = local.aL1Tensor[(buf.aL1BufIter & 1u) * (L1_A_SIZE / sizeof(T))];
+    for (uint32_t n = 0; n < para.n; n += 256) {
+        LoadL1B<T, DataFormat::ND, false>(b[n], 256, para.n, para.k, para.k, buf);
+        WaitFlag<HardEvent::MTE2_MTE1>(B_EVENT0 + (buf.bL1BufIter & 1u));
+        LocalTensor<T> bL1 = local.bL1Tensor[(buf.bL1BufIter & 1u) * (L1_B_SIZE / sizeof(T))];
+        for (uint32_t sub = 0; sub < 256; sub += 64) {
+            WaitFlag<HardEvent::FIX_M>(L0C_EVENT0 + (buf.cL0BufIter & 1u));
+            LocalTensor<Acc> cL0 = local.cL0Tensor[(buf.cL0BufIter & 1u) * (L0C_PP_SIZE / sizeof(Acc))];
+            MmadParams mm(m, 64, para.k, UNIT_FLAG_SET, false, true);
+            MatmulL0<T, Acc, S>(buf, aL1, bL1[para.k * sub], local.aL0Tensor,
+                local.bL0Tensor, cL0, mm, para.k);
+            GetTensorC<T,O,Acc,true>(dst[n+sub],cL0,para.m,64,m,para.orgKc,buf);
+            SetFlag<HardEvent::FIX_M>(L0C_EVENT0 + (buf.cL0BufIter & 1u));
+            ++buf.cL0BufIter;
+        }
+        SetFlag<HardEvent::MTE1_MTE2>(B_EVENT0 + (buf.bL1BufIter & 1u));
+        ++buf.bL1BufIter;
+    }
+    SetFlag<HardEvent::MTE1_MTE2>(A_EVENT0 + (buf.aL1BufIter & 1u));
+    ++buf.aL1BufIter;
+}
